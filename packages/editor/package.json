{
  "name": "@infonomic/editor",
  "version": "2.2.3",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Infonomic editor components.",
  "keywords": [
    "lexical",
    "editor",
    "lexical editor",
    "rich text editor",
    "alternative editor",
    "cms",
    "headless cms",
    "react"
  ],
  "homepage": "https://github.com/infonomic/editor-ai",
  "bugs": {
    "url": "https://github.com/infonomic/editor-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/editor-ai.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "chokidar 'src/**/*' -c 'npm-run-all build'",
    "build": "tsc -p tsconfig.json && tsc-alias && node copy-assets.js",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "clean": "rimraf node_modules dist build .turbo",
    "test": "LOG_LEVEL=off tsx --env-file=.env --test $(find . -name \"*.test.ts\")",
    "test:one": "LOG_LEVEL=off tsx --no-warnings --env-file=.env --test",
    "test:vitest": "vitest run",
    "test:vitest:node": "vitest run --mode node"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toolbar-extensions": {
      "types": "./dist/field/toolbar-extensions.d.ts",
      "import": "./dist/field/toolbar-extensions.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@infonomic/uikit": "^5.43.1",
    "@lexical/clipboard": "^0.41.0",
    "@lexical/code": "^0.41.0",
    "@lexical/hashtag": "^0.41.0",
    "@lexical/headless": "^0.41.0",
    "@lexical/html": "^0.41.0",
    "@lexical/link": "^0.41.0",
    "@lexical/list": "^0.41.0",
    "@lexical/mark": "^0.41.0",
    "@lexical/markdown": "^0.41.0",
    "@lexical/overflow": "^0.41.0",
    "@lexical/react": "^0.41.0",
    "@lexical/rich-text": "^0.41.0",
    "@lexical/selection": "^0.41.0",
    "@lexical/table": "^0.41.0",
    "@lexical/utils": "^0.41.0",
    "classnames": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.3",
    "json-schema": "^0.4.0",
    "lexical": "^0.41.0",
    "react-error-boundary": "^6.1.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
