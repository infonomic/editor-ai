{
	"name": "@infonomic/editor",
	"version": "1.0.0",
	"private": false,
	"license": "MIT",
	"type": "module",
	"description": "Infonomic editor components.",
	"keywords": [
		"lexical",
		"editor",
		"lexical editor",
		"rich text editor",
		"alternative editor",
		"cms",
		"headless cms",
		"react"
	],
	"homepage": "",
	"bugs": {
		"url": ""
	},
	"repository": {
		"type": "git",
		"url": "",
		"directory": "packages/editor"
	},
	"sideEffects": false,
	"scripts": {
		"dev": "chokidar 'src/**/*' -c 'npm-run-all build'",
		"build": "tsc -p tsconfig.json && tsc-alias && node copy-assets.js",
		"lint": "biome check --write --unsafe --diagnostic-level=error",
		"clean": "rimraf node_modules dist build .turbo",
		"test": "LOG_LEVEL=off tsx --env-file=.env --test $(find . -name \"*.test.ts\")",
		"test:one": "LOG_LEVEL=off tsx --no-warnings --env-file=.env --test",
		"test:vitest": "vitest run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@infonomic/uikit": "^5.19.0",
		"@lexical/clipboard": "0.39.0",
		"@lexical/code": "0.39.0",
		"@lexical/hashtag": "0.39.0",
		"@lexical/headless": "0.39.0",
		"@lexical/html": "0.39.0",
		"@lexical/link": "0.39.0",
		"@lexical/list": "0.39.0",
		"@lexical/mark": "0.39.0",
		"@lexical/markdown": "0.39.0",
		"@lexical/overflow": "0.39.0",
		"@lexical/react": "0.39.0",
		"@lexical/rich-text": "0.39.0",
		"@lexical/selection": "0.39.0",
		"@lexical/table": "0.39.0",
		"@lexical/utils": "0.39.0",
		"classnames": "^2.5.1",
		"cross-env": "^10.1.0",
		"eslint": "^9.39.2",
		"json-schema": "^0.4.0",
		"lexical": "0.39.0",
		"react-error-boundary": "^6.0.1",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/json-schema": "^7.0.15",
		"@types/node": "^25.0.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"chokidar": "^5.0.0",
		"chokidar-cli": "^3.0.0",
		"dotenv": "^17.2.3",
		"jsdom": "^27.4.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.16"
	}
}
