{
  "name": "@infonomic/ai",
  "version": "2.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Infonomic AI components.",
  "keywords": [
    "ai",
    "react",
    "lexical"
  ],
  "homepage": "https://github.com/infonomic/editor-ai",
  "bugs": {
    "url": "https://github.com/infonomic/editor-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/editor-ai.git",
    "directory": "packages/ai"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "chokidar 'src/**/*' -c 'npm-run-all build'",
    "build": "tsc -p tsconfig.json && tsc-alias && node copy-assets.js",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "clean": "rimraf node_modules dist build .turbo",
    "test": "LOG_LEVEL=off tsx --env-file=.env --test $(find . -name \"*.test.ts\")",
    "test:one": "LOG_LEVEL=off tsx --no-warnings --env-file=.env --test",
    "test:vitest": "vitest run",
    "test:vitest:node": "vitest run --mode node",
    "list:models": "tsx --env-file=.env src/scripts/list-models.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/lexical": {
      "types": "./dist/plugins/lexical/index.d.ts",
      "import": "./dist/plugins/lexical/index.js"
    },
    "./plugins/text": {
      "types": "./dist/plugins/text/index.d.ts",
      "import": "./dist/plugins/text/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@infonomic/uikit": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/provider-utils": "^4.0.21",
    "@ai-sdk/react": "^3.0.140",
    "@ai-sdk/ui-utils": "^1.2.11",
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/genai": "^1.46.0",
    "@infonomic/schemas": "^2.4.0",
    "@lexical/html": "^0.42.0",
    "@lexical/react": "^0.42.0",
    "@lexical/utils": "^0.42.0",
    "ai": "^6.0.138",
    "ajv": "^8.18.0",
    "classnames": "^2.5.1",
    "cross-env": "^10.1.0",
    "json-schema": "^0.4.0",
    "lexical": "^0.42.0",
    "openai": "^6.32.0",
    "pino": "^10.3.1",
    "react-error-boundary": "^6.1.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@infonomic/uikit": "^6.2.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.3.1",
    "jsdom": "^29.0.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  }
}
