{
  "name": "@infonomic/ai",
  "version": "2.4.3",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Infonomic AI components.",
  "keywords": [
    "ai",
    "react",
    "lexical"
  ],
  "homepage": "https://github.com/infonomic/editor-ai",
  "bugs": {
    "url": "https://github.com/infonomic/editor-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/editor-ai.git",
    "directory": "packages/ai"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "chokidar 'src/**/*' -c 'npm-run-all build'",
    "build": "tsc -p tsconfig.json && tsc-alias && node copy-assets.js",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "clean": "rimraf node_modules dist build .turbo",
    "test": "LOG_LEVEL=off tsx --env-file=.env --test $(find . -name \"*.test.ts\")",
    "test:one": "LOG_LEVEL=off tsx --no-warnings --env-file=.env --test",
    "test:vitest": "vitest run",
    "test:vitest:node": "vitest run --mode node",
    "list:models": "tsx --env-file=.env src/scripts/list-models.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/lexical": {
      "types": "./dist/plugins/lexical/index.d.ts",
      "import": "./dist/plugins/lexical/index.js"
    },
    "./plugins/text": {
      "types": "./dist/plugins/text/index.d.ts",
      "import": "./dist/plugins/text/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@infonomic/uikit": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.15",
    "@ai-sdk/google": "^4.0.16",
    "@ai-sdk/openai": "^4.0.14",
    "@ai-sdk/provider-utils": "^5.0.10",
    "@ai-sdk/react": "^4.0.30",
    "@ai-sdk/ui-utils": "^1.2.11",
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/genai": "^2.11.0",
    "@infonomic/schemas": "^2.4.0",
    "@lexical/html": "^0.47.0",
    "@lexical/react": "^0.47.0",
    "@lexical/utils": "^0.47.0",
    "ai": "^7.0.28",
    "ajv": "^8.20.0",
    "classnames": "^2.5.1",
    "cross-env": "^10.1.0",
    "json-schema": "^0.4.0",
    "lexical": "^0.47.0",
    "openai": "^6.47.0",
    "pino": "^10.3.1",
    "react-error-boundary": "^6.1.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@infonomic/uikit": "^6.7.7",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
