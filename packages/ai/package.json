{
  "name": "@infonomic/ai",
  "version": "2.4.4",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Infonomic AI components.",
  "keywords": [
    "ai",
    "react",
    "lexical"
  ],
  "homepage": "https://github.com/infonomic/editor-ai",
  "bugs": {
    "url": "https://github.com/infonomic/editor-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infonomic/editor-ai.git",
    "directory": "packages/ai"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "chokidar 'src/**/*' -c 'npm-run-all build'",
    "build": "tsc -p tsconfig.json && tsc-alias && node copy-assets.js",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "clean": "rimraf node_modules dist build .turbo",
    "test": "LOG_LEVEL=off tsx --env-file=.env --test $(find . -name \"*.test.ts\")",
    "test:one": "LOG_LEVEL=off tsx --no-warnings --env-file=.env --test",
    "test:vitest": "vitest run",
    "test:vitest:node": "vitest run --mode node",
    "list:models": "tsx --env-file=.env src/scripts/list-models.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/lexical": {
      "types": "./dist/plugins/lexical/index.d.ts",
      "import": "./dist/plugins/lexical/index.js"
    },
    "./plugins/text": {
      "types": "./dist/plugins/text/index.d.ts",
      "import": "./dist/plugins/text/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@infonomic/uikit": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/provider-utils": "^5.0.27",
    "@ai-sdk/react": "^4.0.69",
    "@ai-sdk/ui-utils": "^1.2.11",
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/genai": "^2.17.1",
    "@infonomic/schemas": "^2.4.0",
    "@lexical/html": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "ai": "^7.0.66",
    "ajv": "^8.20.0",
    "classnames": "^2.5.1",
    "cross-env": "^10.1.0",
    "json-schema": "^0.4.0",
    "lexical": "^0.49.0",
    "openai": "^7.4.0",
    "pino": "^10.3.1",
    "react-error-boundary": "^6.1.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@infonomic/uikit": "^6.8.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
